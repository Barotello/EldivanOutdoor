{
  "expo": {
    "name": "Eldivan Outdoor",
    "slug": "eldivan-outdoor",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eldivanoutdoor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F3A2E",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "package": "com.eldivanoutdoor.app"
    },
    "web": {
      "favicon": "./assets/images/favicon-32.png"
    },
    "scheme": "eldivanoutdoor",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Acil durumda konumunu görüntüleyip paylaşabilmen için konum erişimi gerekir."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F3A2E",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 180
        }
      ]
    ]
  }
}
